# ============================================================
# NEVER COMMIT — Sensitive / Credentials
# ============================================================
# API keys, secrets, anything that would let someone use your accounts
.env
.env.local
.env.development
.env.production
.env.test
.env.*.local
*.pem
*.key
*.cert
*.p12
credentials.json
secrets.json
service-account*.json
.aws/
.gcloud/

# ============================================================
# NEVER COMMIT — Confidential Material
# ============================================================
*.pdf

# ============================================================
# NEVER COMMIT — Generated User Data
# ============================================================
# Call audio recordings could contain real conversations / PII
uploads/
recordings/
*.wav
*.mp3
*.m4a
*.ogg

# Database dumps
*.db
*.sqlite
*.sqlite3
dump.rdb
mongodump/

