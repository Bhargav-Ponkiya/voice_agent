# =============================================
# NovaTel Voice Agent — Environment Variables
# Copy this to .env and fill in your values
# DO NOT commit your actual .env to git!
# =============================================

# Server
PORT=3001
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# ---- LiveKit ----
# Sign up free at: https://livekit.io/cloud
# Free tier: 10,000 minutes/month
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxx
LIVEKIT_API_SECRET=your_api_secret_here

# ---- Deepgram (STT + TTS) ----
# Sign up free at: https://console.deepgram.com
# Free tier: $200 credit on signup (covers STT Nova-2 + TTS Aura-2 for hundreds of demo calls)
# ONE key powers both speech-to-text (Nova-2) and text-to-speech (aura-2-asteria-en).
DEEPGRAM_API_KEY=your_deepgram_api_key

# ---- Google Gemini (LLM) ----
# Sign up free at: https://aistudio.google.com
# Free tier: 15 RPM, 1M TPM, 1,500 RPD (completely free, no credit card required)
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL is used for BOTH the realtime streaming agent and the post-call analysis.
# Keep this on gemini-2.5-flash for latency. If you want pro-quality analysis,
# you'd need to plumb a second model var through geminiService.analyzeCall — not done today.
GEMINI_MODEL=gemini-2.5-flash

# ---- MongoDB ----
# Sign up free at: https://mongodb.com/atlas
# Free tier: 512MB (more than enough for this project)
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/novatek-voice?retryWrites=true&w=majority

# ---- File Storage ----
# Path is resolved RELATIVE TO THE PROJECT ROOT, so "uploads/recordings"
# saves files to <project_root>/uploads/recordings/. An absolute path also works.
# The default value below keeps recordings inside the project.
UPLOADS_DIR=uploads/recordings
