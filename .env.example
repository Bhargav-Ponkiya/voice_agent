# =============================================
# NovaTel Voice Agent — Environment Variables
# Copy this to .env and fill in your values
# DO NOT commit your actual .env to git!
# =============================================

# Server
PORT=3001
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# ---- LiveKit ----
# Sign up free at: https://livekit.io/cloud
# Free tier: 10,000 minutes/month
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxx
LIVEKIT_API_SECRET=your_api_secret_here

# ---- Deepgram (STT) ----
# Sign up free at: https://console.deepgram.com
# Free tier: $200 credit on signup (covers hundreds of hours)
DEEPGRAM_API_KEY=your_deepgram_api_key

# ---- Google Gemini (LLM) ----
# Sign up free at: https://aistudio.google.com
# Free tier: 15 RPM, 1M TPM, 1,500 RPD (completely free, no credit card required)
GEMINI_API_KEY=your_gemini_api_key_here
# Model options:
#   gemini-2.5-flash  — fastest, lowest token cost (recommended for real-time voice)
#   gemini-2.5-pro    — higher quality analysis, use for post-call analysis only
GEMINI_MODEL=gemini-2.5-flash

# ---- ElevenLabs (TTS) ----
# Sign up free at: https://elevenlabs.io
# Free tier: 10,000 characters/month (~10-15 demo calls)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
# Voice ID: get from https://elevenlabs.io/voice-library
# "Sarah" (warm, professional): EXAVITQu4vr4xnSDxMaL
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# TTS model: eleven_turbo_v2_5 is fastest (good for real-time)
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# ---- MongoDB ----
# Sign up free at: https://mongodb.com/atlas
# Free tier: 512MB (more than enough for this project)
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/novatek-voice?retryWrites=true&w=majority

# ---- File Storage ----
# Where to save call recordings (relative to server root)
UPLOADS_DIR=../uploads/recordings
