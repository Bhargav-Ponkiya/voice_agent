# =============================================
# NovaTel Voice Agent — Frontend Environment Variables
# Copy to client/.env (gitignored). Vercel: set under Project Settings → Environment Variables.
# =============================================

# Backend URL — leave UNSET in local dev (Vite proxy handles /api and /socket.io).
# In production set this to your Render backend URL (NO trailing slash).
# Example: VITE_API_URL=https://novatel-voice-agent.onrender.com
VITE_API_URL=
